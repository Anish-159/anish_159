MONGODB_URI=mongodb+srv://<DB_USER>:<URL_ENCODED_PASSWORD>@<CLUSTER_HOST>/<DB_NAME>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
CLIENT_URL=http://localhost:5173
PRODUCTION_CLIENT_URL=https://learnzkorean.netlify.app
PORT=5000

# Notes:
# - Do NOT commit actual secrets. Copy this file to `.env` and fill values locally.
# - On Render, set these same variables in the dashboard's Environment section.# MongoDB Atlas connection. Replace <username>, <password>, <cluster> and options as needed.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/korean-ai-academy?retryWrites=true&w=majority

# JWT secret used to sign tokens. Change to a strong random value in production.
JWT_SECRET=change_this_secret_in_production

# Client URL for CORS (development and production)
CLIENT_URL=http://localhost:5173

# In production set this to your deployed frontend URL, e.g. https://your-site.vercel.app
PRODUCTION_CLIENT_URL=https://your-frontend-domain

PORT=5000
